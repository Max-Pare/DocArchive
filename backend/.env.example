# --- Database ---
# Under Docker Compose, DATABASE_URL is injected from POSTGRES_PASSWORD in ../.env.
# Do NOT set it here: a second copy of the password is how this deploy silently broke.
# Set it only for local, non-Docker development:
# DATABASE_URL=postgresql+psycopg2://docarchive:localdevpw@localhost:5432/docarchive

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- File storage (encrypted at rest) ---
# Must match the container path of the `file_data` volume in docker-compose.yml.
# `~` is NOT expanded by Python: a value like ~/.docarch writes to the container's
# writable layer instead of the volume, and every document is lost on the next build.
STORAGE_DIR=/data/files
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# --- Uploads / OCR ---
MAX_UPLOAD_BYTES=26214400
OCR_LANGUAGES=ita
PDF_DPI=200

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173

# --- First admin (created by seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
