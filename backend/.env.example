# --- Database ---
DATABASE_URL=postgresql+psycopg2://docarchive:docarchive@db:5432/docarchive

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- File storage (encrypted at rest) ---
STORAGE_DIR=/data/files
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# --- Uploads / OCR ---
MAX_UPLOAD_BYTES=26214400
OCR_LANGUAGES=ita
PDF_DPI=200

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173

# --- First admin (created by seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
