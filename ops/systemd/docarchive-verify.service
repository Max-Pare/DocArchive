[Unit]
Description=DocArchive monthly restore rehearsal
Documentation=file:///opt/docarchive/ops/RUNBOOK.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/docarchive
# Restores the newest backup into a PARALLEL set of volumes and proves the
# documents in it still decrypt. COMPOSE_PROJECT_NAME is what keeps it away from
# the real archive; do not remove it.
Environment=COMPOSE_PROJECT_NAME=docarchive-verify
# Without COMPOSE_FILE the rehearsal uses the real compose file and fights the
# live stack for ports 80/443.
Environment=COMPOSE_FILE=docker-compose.yml:ops/docker-compose.verify.yml
Environment=API_BASE=http://localhost:18080
ExecStart=/bin/bash -c 'set -euo pipefail; \
    latest=$(printf "%s\\n" "${BACKUP_DIR:-/var/backups/docarchive}"/20*.tar.age | sort | tail -1); \
    /opt/docarchive/ops/restore.sh --yes-destroy-current-data "$latest"; \
    /opt/docarchive/ops/verify-backup.sh'
ExecStopPost=/bin/bash -c 'cd /opt/docarchive && COMPOSE_PROJECT_NAME=docarchive-verify COMPOSE_FILE=docker-compose.yml:ops/docker-compose.verify.yml docker compose down -v || true'
EnvironmentFile=-/etc/docarchive-backup.env
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
