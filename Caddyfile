# {$SITE_ADDRESS} = your domain (auto-HTTPS) in prod, or :80 for local.
{$SITE_ADDRESS} {
	# API -> backend (strip the /api prefix before forwarding)
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# everything else -> frontend SPA
	handle {
		reverse_proxy frontend:80
	}

	# Deliberately above the backend's MAX_UPLOAD_BYTES (25 MiB): the backend should
	# be the one rejecting an oversized upload with a 413 the SPA can explain, not
	# Caddy cutting the body off first.
	request_body {
		max_size 30MB
	}

	encode gzip
}
